# Anthropic / Claude API key (required for AI market matching + analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Kalshi API credentials (optional — app runs in demo mode without these)
# Create a free account at https://kalshi.com and generate an API key
KALSHI_API_KEY=your_kalshi_api_key_here

# Polymarket requires no API key for read-only market data
